{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/coach/chat.mjs": {
      "maxDuration": 60
    },
    "api/coach/health.mjs": {
      "maxDuration": 10
    },
    "api/*.mjs": {
      "maxDuration": 30
    },
    "api/auth/*.mjs": {
      "maxDuration": 30
    },
    "api/auth/google/*.mjs": {
      "maxDuration": 30
    }
  }
}
